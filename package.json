{
	"name": "@cldmv/eslint-plugin-jsonv",
	"version": "1.0.18",
	"description": "ESLint plugin for @cldmv/jsonv files",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"eslint-plugin-jsonv-dev": {
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup && npm run build:types",
		"build:ci": "npm run lint && npm run format:check && npm run build && npm run test:types",
		"build:types": "tsc -p .configs/tsconfig.types.json",
		"test": "node tests/run-vitest.mjs && npm run test:dist",
		"test:dist": "npm run build && node --conditions=eslint-plugin-jsonv-dev --test tests/cjs/entry.test.cjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:types": "npm run build:types && tsc -p tests/types/tsconfig.json",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage && npm run test:dist",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prepack": "npm run build",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/**",
		"!dist/**/*.map",
		"README.md"
	],
	"peerDependencies": {
		"@cldmv/jsonv": "^1.1.0",
		"eslint": "^9.13.0 || ^10.0.0"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/jsonv": "^1.1.5",
		"@cldmv/prettier-plugin-jsonv": "^1.1.4",
		"@cldmv/vitest-runner": "^1.5.6",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"keywords": [
		"eslint",
		"eslintplugin",
		"jsonv",
		"json5",
		"linter",
		"validation",
		"parser",
		"config",
		"es2015",
		"es2020",
		"es2021",
		"bigint",
		"numeric-separators"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CLDMV/jsonv-eslint-plugin-jsonv.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/jsonv-eslint-plugin-jsonv/issues"
	},
	"homepage": "https://github.com/CLDMV/jsonv-eslint-plugin-jsonv/#readme",
	"engines": {
		"node": ">=22.22.0"
	},
	"dependencies": {
		"@eslint/core": "^1.2.1",
		"@eslint/plugin-kit": "^0.7.3"
	}
}
